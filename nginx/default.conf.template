# Serves the React build and proxies /api to the API containers. Terminate TLS in front of this
# (or add a TLS server block) in production; set COOKIE_SECURE=true and TRUST_PROXY=true on the API.
# The nginx image fills in ${API_UPSTREAM} (host:port of the API, default api:4200) when the container starts.
upstream ugarms_api { server ${API_UPSTREAM}; keepalive 16; }

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  server_tokens off;
  client_max_body_size 2048m;

  include /etc/nginx/snippets/security-headers.conf;

  location /api/ {
    proxy_pass http://ugarms_api;
    proxy_http_version 1.1;
    proxy_set_header Connection "";
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_request_buffering off;   # stream large uploads
    proxy_buffering off;           # stream downloads and range requests
    proxy_read_timeout 600s;
  }

  location /assets/ {
    expires 1y;
    add_header Cache-Control "public, immutable";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri =404;
  }

  location / {
    add_header Cache-Control "no-cache";
    include /etc/nginx/snippets/security-headers.conf;
    try_files $uri /index.html;
  }
}
